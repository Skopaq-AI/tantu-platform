  "components": {
    "schemas": {
      "AdapterConfigIn": {
        "properties": {
          "adapter_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9\\-_]{1,63}$",
            "title": "Adapter Id"
          },
          "protocol": {
            "type": "string",
            "title": "Protocol",
            "description": "opcua | modbus | mqtt | mtconnect | ethernet_ip | camera"
          },
          "station_id": {
            "type": "string",
            "title": "Station Id"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          },
          "tags": {
            "items": {
              "$ref": "#/components/schemas/TagMappingIn"
            },
            "type": "array",
            "title": "Tags"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          },
          "poll_interval_ms": {
            "type": "integer",
            "title": "Poll Interval Ms",
            "default": 1000
          }
        },
        "type": "object",
        "required": [
          "adapter_id",
          "protocol",
          "station_id"
        ],
        "title": "AdapterConfigIn"
      },
      "CompoundPreviewIn": {
        "properties": {
          "formula": {
            "type": "string",
            "title": "Formula"
          },
          "variables": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Variables"
          }
        },
        "type": "object",
        "required": [
          "formula",
          "variables"
        ],
        "title": "CompoundPreviewIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestReadingIn": {
        "properties": {
          "station_id": {
            "type": "string",
            "title": "Station Id"
          },
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "unit": {
            "type": "string",
            "title": "Unit",
            "default": ""
          },
          "protocol": {
            "type": "string",
            "title": "Protocol",
            "default": "unknown"
          },
          "adapter_id": {
            "type": "string",
            "title": "Adapter Id",
            "default": ""
          },
          "source_tag": {
            "type": "string",
            "title": "Source Tag",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "station_id",
          "metric",
          "value"
        ],
        "title": "IngestReadingIn"
      },
      "TagMappingIn": {
        "properties": {
          "source_tag": {
            "type": "string",
            "title": "Source Tag"
          },
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "unit": {
            "type": "string",
            "title": "Unit",
            "default": ""
          },
          "scale": {
            "type": "number",
            "title": "Scale",
            "default": 1.0
          },
          "offset": {
            "type": "number",
            "title": "Offset",
            "default": 0.0
          },
          "data_type": {
            "type": "string",
            "title": "Data Type",
            "default": "float"
          },
          "compound_formula": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Compound Formula"
          },
          "source_tags": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Tags"
          }
        },
        "type": "object",
        "required": [
          "source_tag",
          "metric"
        ],
        "title": "TagMappingIn"
      },
      "TokenIn": {
        "properties": {
          "sub": {
            "type": "string",
            "title": "Sub",
            "default": "operator"
          },
          "plant_id": {
            "type": "string",
            "title": "Plant Id",
            "default": "plant-demo-01"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "default": "engineer"
          },
          "exp_min": {
            "type": "integer",
            "title": "Exp Min",
            "default": 60
          }
        },
        "type": "object",
        "title": "TokenIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}